# API Keys - Replace with your actual keys
OPENAI_API_KEY=sk-your-openai-key-here
QWEN_BASE_URL=https://api.mistral.ai/v1
QWEN_MODEL=mistral-large-latest
MISTRAL_API_KEY=your-mistral-key-here

# Azure AI Foundry (per-resource OpenAI v1 endpoint)
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1

# Alibaba Cloud Model Studio / DashScope (region-specific keys)
#DASHSCOPE_API_KEY=
#DASHSCOPE_CN_API_KEY=
#DASHSCOPE_CODING_API_KEY=
#DASHSCOPE_CODING_CN_API_KEY=

# Kimi Code (membership) and Moonshot (pay-as-you-go)
#KIMI_API_KEY=
#MOONSHOT_API_KEY=
#MOONSHOT_CN_API_KEY=

# Other OpenAI-compatible clouds
#DEEPSEEK_API_KEY=
#GROQ_API_KEY=
#XAI_API_KEY=
#TOGETHER_API_KEY=
#FIREWORKS_API_KEY=
#CEREBRAS_API_KEY=
#MINIMAX_API_KEY=
#NVIDIA_API_KEY=
#GMI_API_KEY=
#HUGGINGFACE_API_KEY=
#HF_TOKEN=
#GOOGLE_API_KEY=
#GEMINI_API_KEY=
#OPENROUTER_API_KEY=
# Workers per auto-discovered LM Studio Qwen3.5 2B (default 1). Load 4 separate
# 2B models for 4-wide parallel. Set 2-8 only if one model has that many
# concurrent prediction slots (usually slower than separate instances).
#NANOGENT_SUBAGENT_SLOTS=1

# Cloud rate limits (local LM Studio/Ollama stay unlimited).
# Catalog defaults: OpenRouter 20 RPM / 2 in-flight, Groq 30/2, Cerebras 30/2,
# Hugging Face 15/1. Explicit config or these env vars always win.
# 0 = unlimited. QWEN_MAX_RPM is an alias for QWEN_MAX_REQUESTS_PER_MINUTE.
#QWEN_MAX_REQUESTS_PER_MINUTE=20
#QWEN_MAX_CONCURRENT_LLM=2
# Optional tokens-per-minute pace (no catalog default; 0 = off). QWEN_MAX_TPM is an alias.
#QWEN_MAX_TOKENS_PER_MINUTE=200000
# Per-tool-result cap sent to the LLM after secrets sanitize (0 = off).
# Default when unset: 8000 on remote/cloud, off on local LM Studio/Ollama.
#QWEN_MAX_TOOL_RESULT_TOKENS=8000
# Explicit failover after LLM retries (429/502/503/504, timeout, connection).
# Never invented — local does not fail over to cloud unless you set this.
# File `fallbacks` in ~/.nanogent.json wins over these env vars. Invalid values are logged, not applied.
#QWEN_FALLBACK_MODEL=openrouter/free
#QWEN_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#QWEN_FALLBACK_PROVIDER=openrouter
# Manual USD per 1M tokens when the catalog has no price (file wins over env).
#QWEN_PROMPT_PRICE_PER_MILLION=
#QWEN_COMPLETION_PRICE_PER_MILLION=
# Prompt-cache Chat Completions extras (prompt_cache_key) when the catalog
# explicitly reports cache support. Local providers always skip. 0/false = off.
#QWEN_PROMPT_CACHE=1

# Thinking / reasoning effort: none|low|medium|high|extra-high (default low).
# File `effort` in ~/.nanogent.json wins. Invalid values are logged, not applied.
#QWEN_EFFORT=low

# Per-turn inactivity timeout (ms) for sub-agent workers (min 10000; raise for slow hosts)
#NANOGENT_SUBAGENT_TURN_TIMEOUT_MS=600000

# Context / auto-compact (window comes from the loaded model's max context;
# default trigger is 80% — ~210k on a 262k model, ~50k headroom)
#QWEN_CONTEXT_COMPACT_THRESHOLD=0.8
#QWEN_CONTEXT_SUMMARY_RESERVED_PERCENT=0.15
#QWEN_CONTEXT_KEEP_COUNT=12
#QWEN_CONTEXT_MAX_HISTORY_TOKENS=
#QWEN_CONTEXT_MANAGEMENT_ENABLED=1
